  apriltag:
    type: git
    url: https://github.com/AprilRobotics/apriltag
    # Pinned (was 'master'): freeze AprilTag detection deps to the last known-good
    # SHA so image rebuilds don't float on upstream master. See dexi_bringup PR.
    version: 1c21707aa7304121a2529a71f8e512f6542f35d0

  apriltag_ros:
