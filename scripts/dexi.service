[Unit]
Description=DEXI ROS2 Bringup Service
# The boards have no RTC. Without this the stack starts on the stale
# saved clock and every log line before NTP lands is timestamped wrong.
Wants=time-sync.target
After=time-sync.target

[Service]
Type=simple
User=root
Environment="HOME=/home/dexi"
WorkingDirectory=/home/dexi
ExecStart=/home/dexi/dexi_ws/src/dexi_bringup/scripts/start.bash
StandardOutput=journal
StandardError=journal
Restart=on-failure

[Install]
WantedBy=multi-user.target